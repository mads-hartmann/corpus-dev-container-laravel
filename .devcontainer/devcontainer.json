{
  "name": "Laravel",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/php": {
      "version": "8.4"
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "22"
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Laravel application",
      "onAutoForward": "notify"
    }
  }
}
